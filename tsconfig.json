{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"types": ["@types/bun"],
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true
	},
	"include": ["scripts/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
