{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.ts"],
			"project": ["scripts/**/*.ts"]
		},
		"plugins/*": {
			"entry": ["index.ts", "ui/schema*.ts"],
			"project": ["*.ts", "src/**/*.ts", "ui/schema*.ts"]
		},
		"plugins/*/ui": {
			"entry": ["src/index.tsx", "schema*.ts"],
			"project": ["src/**/*.{ts,tsx}", "*.ts"]
		}
	},
	"ignoreExportsUsedInFile": true,
	"rules": {
		"exports": "off",
		"types": "off",
		"duplicates": "off"
	}
}
