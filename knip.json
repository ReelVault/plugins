{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"entry": ["tests/**/*.test.ts", "scripts/**/*.ts"],
	"project": ["src/**/*.ts", "sdk/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
	"ignoreDependencies": [],
	"ignoreBinaries": ["ffmpeg"],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"exports": "off",
		"types": "off",
		"duplicates": "off"
	}
}
